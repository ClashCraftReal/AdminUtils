{
	"schemaVersion": 1,
	"id": "adminutils",
	"version": "${version}",
	"name": "Admin Utils",
	"description": "Useful Admin Perms for Server Admins",
	"authors": [
		"Cl4sh"
	],
	"contact": {
		"homepage": "https://fabricmc.net/",
		"sources": "https://github.com/ClashCraftReal/AdminUtils"
	},
	"license": "CC0-1.0",
	"icon": "assets/adminutils/icon.png",
	"environment": "*",
	"entrypoints": {
		"main": [
			"com.lorenz.adminutils.AdminUtils"
		],
		"client": [
			"com.lorenz.adminutils.client.AdminUtilsClient"
		]
	},
	"mixins": [
		"adminutils.mixins.json",
		{
			"config": "adminutils.client.mixins.json",
			"environment": "client"
		}
	],
	"depends": {
		"fabricloader": ">=${loader_version}",
		"minecraft": "${minecraft_dependency}",
		"java": ">=${java_version}",
		"fabric-api": "*"
	}
}